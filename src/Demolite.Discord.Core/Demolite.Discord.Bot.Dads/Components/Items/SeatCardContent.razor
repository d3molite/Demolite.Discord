@using System.Security.Cryptography
@using System.Text
@using Demolite.Discord.Bot.Dads.Services

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="h-100 w-100 p-1"
          Style="@($"{GroupBackgroundStyle} max-height: 100% !important; overflow: hidden; min-height: 0;")">
    <MudText Typo="Typo.body2" Style="@UsernameStyle">@Member.UsernameForDisplay</MudText>
    @if (!string.IsNullOrWhiteSpace(Member.PersonalName))
    {
        <MudText Typo="Typo.caption">@Member.PersonalName</MudText>
    }
    else
    {
        <MudText Typo="Typo.caption">-</MudText>
    }
</MudStack>

@code {
    
    private const string UsernameStyle =
        "word-break: break-word; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.15; text-align: center;";
    
    [Parameter, EditorRequired]
    public required LanMember Member { get; set; }
    

    private string GroupBackgroundStyle =>
        string.IsNullOrWhiteSpace(Member.Group)
            ? "border-radius: var(--mud-default-borderradius);"
            : $"border-radius: var(--mud-default-borderradius); background: {HashToColor(Member.Group)};";

    private static string HashToColor(string group)
    {
        var hashBytes = SHA256.HashData(Encoding.UTF8.GetBytes(group));
        var seed = BitConverter.ToUInt32(hashBytes, 0);

        const double goldenRatioConjugate = 0.618033988749895;
        var hue = (seed * goldenRatioConjugate % 1.0) * 360;

        return $"hsla({hue:F0}, 60%, 35%, 50%)";
    }
}